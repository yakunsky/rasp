        "projectId": "f9ee1348-6950-4306-943e-919cb197f5a1"
      }
    },
    "android": {
      "package": "com.ykunskiy.schoolschedule",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "pan"
